DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jobfit?schema=public"

# Stripe — secret stays server-side only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Dashboard → JobFit AI Pro Report — one-time EUR 4.99
STRIPE_PRO_REPORT_PRICE_ID=

# Pro Report promo codes (create percent-off "once" Coupons in Stripe, same % as code)
STRIPE_PROMO_COUPON_LAUNCH50=
STRIPE_PROMO_COUPON_STUDENT30=
# Optional ISO expiry (omit = no expiry)
# STRIPE_PROMO_EXPIRES_LAUNCH50=2027-06-01T23:59:59.000Z

# Stripe Dashboard → JobFit AI Monthly Pro — recurring EUR 9.99 / month
STRIPE_MONTHLY_PRO_PRICE_ID=

# Optional until you add Stripe Elements elsewhere
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# HMAC secret for HTTP-only cookies: anonymous usage session + Monthly Pro + legacy Pro grant list (`jobfit_mp`, `jobfit_pg`) — min 16 chars in production
JOBFIT_USAGE_SECRET=

# Separate secret for anonymous Pro Report entitlement cookie (`jobfit_pr_ent`) — min 16 chars in production; isolates one-time report access from other signed cookies
JOBFIT_ENTITLEMENT_SECRET=

# Staging/debug: prepaid credit confirm responses may include `debugReason` + `bindSubtype` (Railway NODE_ENV is often production — set JOBFIT_BILLING_DIAGNOSTICS=true on staging only)
# JOBFIT_BILLING_DIAGNOSTICS=true

# Dev only: bypass /api/analyze usage limits (never enable in production)
# JOBFIT_SKIP_USAGE_LIMITS=true