# =============================================================================
# Server-only secrets — never commit real values; never prefix with NEXT_PUBLIC_
# =============================================================================

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jobfit?schema=public"

# Stripe (Dashboard → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Dashboard → JobFit AI Pro Report — one-time EUR 4.99
STRIPE_PRO_REPORT_PRICE_ID=

# Pro Report promo codes (create percent-off "once" Coupons in Stripe, same % as code)
STRIPE_PROMO_COUPON_LAUNCH50=
STRIPE_PROMO_COUPON_STUDENT30=
# Optional ISO expiry (omit = no expiry)
# STRIPE_PROMO_EXPIRES_LAUNCH50=2027-06-01T23:59:59.000Z

# Stripe Dashboard → JobFit AI Monthly Pro — recurring EUR 9.99 / month
STRIPE_MONTHLY_PRO_PRICE_ID=

# OpenRouter — CV analysis, ATS checklist, cover letter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Legacy alias supported locally only:
# OPENAI_API_KEY=

# HMAC secrets for HttpOnly signed cookies (min 16 chars each in production)
JOBFIT_USAGE_SECRET=
JOBFIT_ENTITLEMENT_SECRET=

# Optional staging QA only — never set in production (see NEXT_PUBLIC_APP_ENV below)
# JOBFIT_BILLING_DIAGNOSTICS=true

# Dev only: bypass /api/analyze usage limits (never enable in production)
# JOBFIT_SKIP_USAGE_LIMITS=true

# =============================================================================
# Public client variables (NEXT_PUBLIC_*) — safe to expose to the browser bundle
# No API keys, webhook secrets, or HMAC signing material here.
# =============================================================================

# Canonical site URL for Stripe success/cancel redirects (must match deployed origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# deployment label: development | staging | production (hides billing sandbox UI on staging/production)
NEXT_PUBLIC_APP_ENV=development

# Optional: force-hide billing sandbox UI even on localhost
# NEXT_PUBLIC_HIDE_BILLING_SANDBOX_UI=1

# Optional: show published testimonials section (omit or leave unset until you have permission)
# NEXT_PUBLIC_JOBFIT_TESTIMONIALS=published
