generator client {
  provider = "prisma-client-js"
}

// Use a dedicated DB role with least privilege on this schema in production (not a superuser connection string).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnalysisSnapshot {
  analysisId String   @id @map("analysis_id")
  resultText String   @map("result_text")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("analysis_snapshots")
}

model ProReportUnlock {
  id                      String   @id @default(cuid())
  analysisId              String   @unique @map("analysis_id")
  stripeCheckoutSessionId String   @unique @map("stripe_checkout_session_id")
  /// Stripe Customer — backfilled when checkout completes or first saved report sync.
  stripeCustomerId        String?  @map("stripe_customer_id")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([stripeCustomerId])
  @@map("pro_report_unlocks")
}

/// One-time “paid analysis + Pro Report” credit before `analysisId` exists (Stripe `metadata.jobfit_product = pro_report_credit`).
model ProReportPendingCredit {
  id                      String    @id @default(cuid())
  stripeCheckoutSessionId String    @unique @map("stripe_checkout_session_id")
  stripeCustomerId        String?   @map("stripe_customer_id")
  /// Bound server-side when /confirm-session runs in purchaser’s browser (same anonymous session cookie may consume via /api/analyze).
  anonymousSessionId      String?   @map("anonymous_session_id")
  consumedAt              DateTime? @map("consumed_at")
  consumedAnalysisId      String?   @map("consumed_analysis_id")
  createdAt               DateTime  @default(now()) @map("created_at")

  @@index([anonymousSessionId])
  @@map("pro_report_pending_credits")
}

model SavedReport {
  id               String   @id @default(cuid())
  analysisId       String   @unique @map("analysis_id")
  stripeCustomerId String   @map("stripe_customer_id")
  cvText           String   @map("cv_text")
  jdText           String   @map("jd_text")
  resultText       String   @map("result_text")
  jobTitle         String?  @map("job_title")
  companyName      String?  @map("company_name")
  fitScore         Int?     @map("fit_score")
  /// monthly_pro | pro_report — drives library access after subscription lapses.
  tier             String   @default("monthly_pro") @map("tier")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([stripeCustomerId])
  @@map("saved_reports")
}

// Billing profile keyed by Stripe Customer (subscription state for Monthly Pro).
model BillingAccount {
  id                   String    @id @default(cuid())
  stripeCustomerId     String    @unique @map("stripe_customer_id")
  email                String?   @map("email")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  /// Stripe subscription.status, or "none" if no active row semantics
  subscriptionStatus   String    @default("none") @map("subscription_status")
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  lastPaymentFailedAt  DateTime? @map("last_payment_failed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("billing_accounts")
}

// Authenticated profile — tie AnalysisUsage.userId once NextAuth/session exists.
model User {
  id        String   @id @default(cuid())
  email     String?  @unique @map("email")
  createdAt DateTime @default(now()) @map("created_at")

  usage AnalysisUsage?

  @@map("users")
}

// Analysis quotas (daily free tier vs Monthly Pro monthly bucket). Exactly one identity column should be set.
model AnalysisUsage {
  id String @id @default(cuid())

  userId String? @unique @map("user_id")
  User   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  anonymousSessionId String? @unique @map("anonymous_session_id")
  stripeCustomerId   String? @unique @map("stripe_customer_id")

  dailyBucketUtc   String @map("daily_bucket_utc")
  dailyCount       Int    @default(0) @map("daily_count")
  monthlyBucketUtc String @map("monthly_bucket_utc")
  monthlyCount     Int    @default(0) @map("monthly_count")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("analysis_usage")
}

/// Optional marketing / report delivery — only created when user submits email + explicit consent.
model GrowthEmailConsent {
  id        String   @id @default(cuid())
  /// Normalized lowercase email
  email     String   @map("email")
  consentAt DateTime @default(now()) @map("consent_at")
  /// Must match EMAIL_CAPTURE_* snapshot at signup time.
  consentCopyVersion String @map("consent_copy_version")
  analysisId String? @map("analysis_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@map("growth_email_consents")
}